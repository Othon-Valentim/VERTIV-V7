# ============================================================================
# VERTIV v6.1.0-SINGULARITY - Production Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values for your production deployment.
# NEVER commit the actual .env file to version control.
# ============================================================================

# --- Environment ---
ENV=production
DEBUG=false

# --- API Configuration ---
API_URL=https://api.vertiv.tech
ALLOWED_ORIGINS=https://vertiv.tech,https://www.vertiv.tech

# --- Supabase (Database & Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# --- Google Cloud ---
GCP_PROJECT_ID=vertiv-prod-v1
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Cloud Tasks (Worker Queue) ---
WORKER_URL=https://worker.vertiv.tech/tasks/process-simulation
CLOUD_TASKS_QUEUE=vertiv-simulations
CLOUD_TASKS_LOCATION=us-central1

# --- Serper API (Live Web Search) ---
# Get your API key from https://serper.dev
SERPER_API_KEY=your-serper-api-key-here

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_SECOND=10
SIMULATION_RATE_LIMIT_PER_MINUTE=30

# --- Security ---
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=https://vertiv.tech,https://www.vertiv.tech

# --- Monitoring (Optional) ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Feature Flags ---
ENABLE_LIVE_SEARCH=true
ENABLE_REAL_OPTIONS=true
ENABLE_ESG_CALCULATION=true
