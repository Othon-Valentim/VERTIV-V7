# ============================================================================
# VERTIV v6.1.0-SINGULARITY - Production Environment Variables
# ============================================================================

# --- Core ---
ENV=production
DEBUG=False
PORT=8080

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/vertiv_db

# --- Security ---
SECRET_KEY=troque_isso_por_uma_hash_segura
CORS_ORIGINS=https://vertiv.tech,https://www.vertiv.tech

# --- API Configuration ---
API_URL=https://api.vertiv.tech
ALLOWED_ORIGINS=https://vertiv.tech,https://www.vertiv.tech

# --- Supabase (Database & Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET_HERE

# --- Live Intelligence APIs ---
# Scout Agent - Web Search
SERPER_API_KEY=[COLE_SUA_CHAVE_AQUI]
# IT-11 & BCB Live Data
BCB_API_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.dados/retorno/json

# --- Google Cloud ---
GCP_PROJECT_ID=vertiv-platform-v5
GCP_REGION=southamerica-east1

# --- Cloud Tasks (Worker Queue) ---
WORKER_URL=https://worker.vertiv.tech/tasks/process-simulation
CLOUD_TASKS_QUEUE=vertiv-simulations
CLOUD_TASKS_LOCATION=southamerica-east1

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_SECOND=10
SIMULATION_RATE_LIMIT_PER_MINUTE=30

# --- Monitoring ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Feature Flags ---
ENABLE_LIVE_SEARCH=true
ENABLE_REAL_OPTIONS=true
ENABLE_ESG_CALCULATION=true

